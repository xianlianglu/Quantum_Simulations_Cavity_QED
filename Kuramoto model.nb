Notebook[{
Cell[BoxData[{
 RowBox[{
  RowBox[{"Kc", " ", "=", " ", "1"}], ";", " ", 
  RowBox[{"(*", 
   RowBox[{
   "We", " ", "set", " ", "a", " ", "constant", " ", "coupling", " ", 
    "between", " ", "oscillators"}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{"n", "=", "10"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"\[Omega]", " ", "=", " ", 
   RowBox[{"RandomReal", "[", 
    RowBox[{"1", ",", "n"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Theta", " ", "=", " ", 
   RowBox[{"Table", "[", 
    RowBox[{
     SubscriptBox["\[Theta]", "i"], ",", 
     RowBox[{"{", 
      RowBox[{"i", ",", "1", ",", "n"}], "}"}]}], "]"}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.984852021069378*^9, 
  3.984852061127798*^9}},ExpressionUUID->"831b986b-af10-44d5-ab8a-\
0b0d39c37fd2"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"creating", " ", "Differential", " ", "equations"}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"Dlist", " ", "=", " ", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"\[Omega]", "[", 
        RowBox[{"[", "i", "]"}], "]"}], "+", 
       RowBox[{
        FractionBox["Kc", "n"], 
        RowBox[{"Sum", "[", 
         RowBox[{
          RowBox[{"Sin", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"Theta", "[", 
              RowBox[{"[", "j", "]"}], "]"}], "[", "t", "]"}], "-", 
            RowBox[{
             RowBox[{"Theta", "[", 
              RowBox[{"[", "i", "]"}], "]"}], "[", "t", "]"}]}], "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"j", ",", "1", ",", "n"}], "}"}]}], "]"}]}]}], ",", 
      RowBox[{"{", 
       RowBox[{"i", ",", "1", ",", "n"}], "}"}]}], "]"}]}], ";"}]}]], "Input",\

 CellChangeTimes->{{3.984852002316717*^9, 3.984852013853898*^9}},
 CellLabel->
  "In[256]:=",ExpressionUUID->"6f590302-b7a8-4808-9dda-254aa6bbec68"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"eqs", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"D", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"Theta", "[", 
          RowBox[{"[", "i", "]"}], "]"}], "[", "t", "]"}], ",", "t"}], "]"}], 
      "==", 
      RowBox[{"Dlist", "[", 
       RowBox[{"[", "i", "]"}], "]"}]}], ",", 
     RowBox[{"{", 
      RowBox[{"i", ",", "1", ",", "n"}], "}"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"inis", " ", "=", " ", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"Theta", "[", 
        RowBox[{"[", "i", "]"}], "]"}], "[", "0", "]"}], "==", 
      RowBox[{"RandomReal", "[", 
       RowBox[{"2", "Pi"}], "]"}]}], ",", 
     RowBox[{"{", 
      RowBox[{"i", ",", "1", ",", "n"}], "}"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"sol", "=", 
   RowBox[{"NDSolve", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"eqs", ",", "inis"}], "}"}], ",", "Theta", " ", ",", 
     RowBox[{"{", 
      RowBox[{"t", ",", "0", ",", "10"}], "}"}]}], "]"}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.984851018665037*^9, 3.984851093323957*^9}, {
   3.9848511366330833`*^9, 3.9848512634561*^9}, {3.984851318936586*^9, 
   3.984851327417939*^9}, {3.984851389114771*^9, 3.9848513991925697`*^9}, 
   3.9848514976857653`*^9, {3.984851960905354*^9, 3.984851961136614*^9}},
 CellLabel->
  "In[257]:=",ExpressionUUID->"3c08dbd9-12d9-4ab9-a234-efa13323b62f"],

